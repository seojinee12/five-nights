GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok API Key
# Used for real-time dynamic schedule triage and chat-based engineering mentoring
# Obtain from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
